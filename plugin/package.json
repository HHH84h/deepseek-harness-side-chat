{
  "name": "dsh-client-ui-side",
  "version": "1.1.3",
  "private": true,
  "description": "Temporary read-only side chat in the right sidebar, seeded with an explicit snapshot of the current conversation",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./host": {
      "default": "./lib/host.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "update-source.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "HHH84h",
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-resources": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.5",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-reference": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-preset": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-resources": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    },
    "@deepseek-ai/dsh-persona": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-reference": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-fs-search": {
      "optional": true
    }
  }
}
